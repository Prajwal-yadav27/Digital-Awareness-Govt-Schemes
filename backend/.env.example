PORT=5000

# Runtime environment: set to "production" for deployed builds
NODE_ENV=production

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>

# JWT authentication secret (use a long random string)
JWT_SECRET=<your-jwt-secret>

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Twitter OAuth 2.0 credentials
TWITTER_CLIENT_ID=<your-twitter-client-id>
TWITTER_CLIENT_SECRET=<your-twitter-client-secret>
TWITTER_CALLBACK_URL=http://localhost:5000/api/auth/twitter/callback

# Razorpay payment gateway credentials
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
# Razorpay webhook secret (from the Razorpay dashboard webhook settings).
# Required in production for POST /api/payments/webhook signature verification.
# Without it the webhook endpoint refuses to process events (HTTP 503).
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# Payment mock mode: set to "true" only for local development/testing without live Razorpay account
# When not "true", real Razorpay API is used and failures return 503 instead of silent mock fallback
PAYMENT_MOCK_MODE=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (used for OAuth redirects and password reset links)
FRONTEND_URL=http://localhost:5173

# SMTP email delivery (used for password reset emails)
# Leave unset for local development without email delivery
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
SMTP_FROM=<your-from-email-address>

# SMS delivery (used for OTP and important notifications)
# Leave unset for local development without SMS delivery.
# SMS_PROVIDER must be a real provider (currently: twilio).
# Never set SMS_PROVIDER=mock in production: startup validation fails
# instead of silently pretending SMS was sent.
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=<your-twilio-account-sid>
SMS_AUTH_TOKEN=<your-twilio-auth-token>
SMS_FROM=<your-twilio-phone-number>
# Optional: bounds each SMS provider request (milliseconds, 3000-60000)
SMS_TIMEOUT_MS=15000
# India production note: transactional OTP SMS to +91 numbers requires DLT
# registration (entity + headers/sender IDs + approved templates) with your
# provider. Trial accounts are restricted (destinations/templates) and are
# not suitable for production OTP delivery.

# Allow public admin registration (set to "true" only for initial setup)
ALLOW_PUBLIC_ADMIN_REGISTER=false

# Admin seed password (used only by backend/seedAdmin.js to create the initial
# admin account when it does not already exist). Provide a strong value per
# environment. Never commit a real password here.
SEED_ADMIN_PASSWORD=<your-secure-admin-seed-password>
